# 실제 값을 채운 뒤 이 파일을 .env로 복사해서 사용한다.
# .env는 .gitignore에 포함되어 있으므로 커밋되지 않는다.
# API_KEY/API_SECRET은 절대 채팅/커밋에 붙여넣지 말 것 — 이 파일에만 직접 입력한다.
# Phase 2 읽기전용 라이브 확인 단계에서는 반드시 "읽기 전용" 권한 키만 사용한다 (출금/주문 권한 없는 키 권장).

EXCHANGE=orangex
TRADING_MODE=paper
API_KEY=
API_SECRET=
SYMBOL=BTC-USDT-PERPETUAL
# long / short / auto / both  (2026-08-17 개편)
#   long|short : 방향 고정. 일봉 RSI(14) <=30/>=70 게이트를 통과해야 진입 시작(SPEC 원안).
#   auto       : 사이클마다 15분봉 RSI(14)로 방향을 정한다(>=50 숏, <50 롱). 자금 전액을
#                한 방향에 쓰고, 방향이 바뀌면 어댑터 스택을 통째로 재조립한다.
#                MANUAL_MODE=true와는 같이 쓸 수 없다(사이클이 끝나는 경로가 없어짐).
#   both       : 롱/숏을 동시에 깔고, **합산** 손익이 투입 증거금 대비 COMBINED_TP_ROE에
#                도달하면 양쪽 전량 청산 후 즉시 재진입. 개별 TP/SL/hybrid reset은 전부 꺼진다.
#                EQUITY_USDT를 반씩 나눠 쓰므로 최소 시드가 단방향의 2배 필요하다.
# auto/both 둘 다 헤지 모드 계좌 필요 — OrangeX 앱에서 해당 종목의 Position Mode가
# Hedge(One-way 아님)로 설정돼 있어야 한다.
DIRECTION=long
# launcher.py의 "즉시 진입"(숏!/롱!) 메뉴도 이 값을 그대로 쓴다 — config/weights.csv
# 비중대로 EQUITY_USDT 전액을 배분하므로, 즉시 진입을 한 번 실행할 때마다 이 방향에
# 배정된 자금 전체가 소진된다(가격 범위는 몇 단계에 나눠 담을지만 정할 뿐 총액과 무관).
EQUITY_USDT=10000
# 격자 프리셋(2026-08-17). 3k / 5k 중 하나를 고르면 "현재가 기준 +-가격 범위"가 정해지고,
# 거기서 MAX_STAGE와 LEVERAGE(40배 고정)가 자동으로 결정된다 — 이 값을 넣으면 아래
# LEVERAGE / MAX_STAGE는 **무시된다**(기동 로그에 실제 적용값이 찍힌다).
#   3k -> 60단계(MAX_STAGE=3), 40배. 최소 시드 약 548 USDT (both면 1,096)
#   5k -> 100단계(MAX_STAGE=5), 40배. 최소 시드 약 2,656 USDT (both면 5,312)
# 비워두면 아래 LEVERAGE / MAX_STAGE를 그대로 쓴다(기존 동작).
GRID_PRESET=
LEVERAGE=20
GRID_TICK=50
MAX_STAGE=3
# MAX_STAGE차 이상 진입 시 거래소 SL 필수 등록. MAX_STAGE=3(3-tier 압축 설계,
# 제까깟-마틴게이-3k.xlsx 기준)이면 3으로, MAX_STAGE=5(SPEC 원안 5-tier 풀 구조,
# "4~5차 필수 SL")로 쓸 거면 4로 맞춘다 — 안 맞으면 major_tier가 이 값에 절대
# 도달 못 해 SL이 영원히 등록되지 않을 수 있다(2026-08-04 확인된 문제, 수정됨).
MANDATORY_SL_MIN_TIER=3
# false면 거래소 SL(STOP 주문)을 아예 등록하지 않는다(2026-08-17 추가). SPEC의
# "4~5차 SL 필수"에서 벗어나는 설정이라, 이 경우 격자 최심 주문가와 청산가 사이의
# 완충(3k 프리셋/40배 기준 약 2%p)이 유일한 방어선이 된다.
SL_ENABLED=true
# DIRECTION=both 전용. 롱/숏 합산 미실현손익이 투입 증거금 합계 대비 이 비율에
# 도달하면 양쪽을 전량 청산하고 즉시 재진입한다. 수수료(진입 maker + 청산 taker)를
# 차감한 실현 가능한 수익률로 판정한다. 0.10 = 10%.
COMBINED_TP_ROE=0.10
DAILY_LOSS_LIMIT_PCT=
COOLDOWN_MINUTES=30
# true면 진입 게이트 없이 현재가 기준 격자 매수/매도 진입만 자동화하고,
# TP 재등록/SL 등록/hybrid reset 등 청산 자동화는 전부 끈다(사용자가 거래소에서
# 직접 수동으로 청산 관리). 기본값 false(완전자동).
# **주의**: 이 값이 true면 RSI도 TP도 전부 꺼진다. DIRECTION=auto와는 병용 불가.
MANUAL_MODE=false
