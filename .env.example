# 실제 값을 채운 뒤 이 파일을 .env로 복사해서 사용한다.
# .env는 .gitignore에 포함되어 있으므로 커밋되지 않는다.
# API_KEY/API_SECRET은 절대 채팅/커밋에 붙여넣지 말 것 — 이 파일에만 직접 입력한다.
# Phase 2 읽기전용 라이브 확인 단계에서는 반드시 "읽기 전용" 권한 키만 사용한다 (출금/주문 권한 없는 키 권장).

EXCHANGE=orangex
TRADING_MODE=paper
API_KEY=
API_SECRET=
SYMBOL=BTC-USDT-PERPETUAL
# long / short / both. "both"면 EQUITY_USDT를 반씩 나눠 롱/숏을 완전히 독립적으로
# 동시에 운용한다(2026-08-04 추가). 헤지 모드 계좌 필요 — OrangeX 앱에서 해당 종목의
# Position Mode가 Hedge(One-way 아님)로 설정돼 있어야 한다.
DIRECTION=long
EQUITY_USDT=10000
LEVERAGE=20
GRID_TICK=50
MAX_STAGE=3
# MAX_STAGE차 이상 진입 시 거래소 SL 필수 등록. MAX_STAGE=3(3-tier 압축 설계,
# 제까깟-마틴게이-3k.xlsx 기준)이면 3으로, MAX_STAGE=5(SPEC 원안 5-tier 풀 구조,
# "4~5차 필수 SL")로 쓸 거면 4로 맞춘다 — 안 맞으면 major_tier가 이 값에 절대
# 도달 못 해 SL이 영원히 등록되지 않을 수 있다(2026-08-04 확인된 문제, 수정됨).
MANDATORY_SL_MIN_TIER=3
DAILY_LOSS_LIMIT_PCT=
COOLDOWN_MINUTES=30
# true면 RSI 진입 필터 없이 현재가 기준 격자 매수/매도 진입만 자동화하고,
# TP 재등록/SL 등록/hybrid reset 등 청산 자동화는 전부 끈다(사용자가 거래소에서
# 직접 수동으로 청산 관리). 기본값 false(완전자동).
MANUAL_MODE=false
# launcher.py의 "즉시 진입"(숏!/롱!) 메뉴가 쌓는 지정가 주문 1개당 증거금(USDT).
# 진입만 자동화 — TP/SL은 MANUAL_MODE와 동일하게 사용자가 거래소에서 직접 관리한다.
QUICK_ENTRY_CHUNK_USDT=50
